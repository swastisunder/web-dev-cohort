    },
    {
      "id": "tlU9UCO-c4pWKwDAVWt6x",
      "type": "text",
      "x": 1420.7505257865498,
      "y": 29.27316979741468,
      "width": 768.0394897460938,
      "height": 175,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 914217910,
      "version": 583,
      "versionNonce": 444485610,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785037348358,
      "link": null,
      "locked": false,
      "text": "- Node Js is a runtime environment which run js outside the browser\n- JS on the server\n- Before node js only run on browser\n- There is a JS Engine by Google called V8\n- They add a layer of libuv with V8\n- Libuv provide async I/O layer which help to talk to network connect with OS\n- And the whole thing V8 with Libuv is called NODEJS",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Node Js is a runtime environment which run js outside the browser\n- JS on the server\n- Before node js only run on browser\n- There is a JS Engine by Google called V8\n- They add a layer of libuv with V8\n- Libuv provide async I/O layer which help to talk to network connect with OS\n- And the whole thing V8 with Libuv is called NODEJS",
      "autoResize": true,
      "lineHeight": 1.25
    },
